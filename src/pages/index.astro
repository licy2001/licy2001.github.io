---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
const posts = (await getCollection('posts')).sort((a,b) => b.data.published.valueOf() - a.data.published.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year:'numeric', month:'2-digit', day:'2-digit' });
---
<Base>
  <header class="hero" id="top">
    <HeroScene />
    <nav><a class="brand" href="#top">L<span>✦</span>CY</a><div><a href="#journal">文章</a><a href="#about">关于</a><a href="https://github.com/licy2001" target="_blank" rel="noreferrer">GitHub ↗</a></div></nav>
    <div class="hero-art" aria-hidden="true"><i class="moon"></i><i class="window"></i><i class="desk"></i><i class="lamp"></i></div>
    <div class="hero-copy"><p class="eyebrow">A personal corner on the internet</p><h1>Licy 的<br /><em>夜航日志</em></h1><p>记录代码、思考与生活。<br />在安静的夜里，把正在发生的事写下来。</p><a class="scroll-cue" href="#journal"><b>↓</b> 阅读近况</a></div>
  </header>
  <main id="main" class="page-shell">
    <aside class="profile" id="about"><div class="avatar">L</div><p class="mini">你好，我是</p><h2>Licy</h2><p class="role">Quant · Builder · Learner</p><p class="bio">这里收纳研究、代码实验和一些没有结论的思考。</p><div class="social"><a href="https://github.com/licy2001" target="_blank" rel="noreferrer">GitHub</a></div><div class="side-section"><h3>分类</h3><a href="#journal">量化研究</a><a href="#journal">开发笔记</a><a href="#journal">随笔</a></div></aside>
    <section id="journal" class="journal"><div class="section-head"><div><p class="eyebrow dark">Latest entries</p><h2>最近记录</h2></div><span>{posts.length.toString().padStart(2,'0')} 篇文章</span></div>
      <div class="post-list">{posts.map((post, index) => <article class:list={["post-card", { featured:index === 0 }]}><a href={`/posts/${post.id.replace(/\.md$/, '')}/`}><div class="post-no">0{index + 1}</div><div class="post-copy"><p class="meta">{formatDate(post.data.published)} · {post.data.category}</p><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div></div><div class="orb" aria-hidden="true"></div></a></article>)}</div>
    </section>
  </main>
  <footer><span>© {new Date().getFullYear()} Licy</span><a href="#top">回到顶部 ↑</a></footer>
</Base>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);
    const tl = gsap.timeline({ defaults:{ ease:'power3.out' } });
    tl.from('nav', { y:-24, autoAlpha:0, duration:.7 }).from('.hero-copy > *', { y:28, autoAlpha:0, stagger:.12, duration:.85 }, '-=.3');
    gsap.utils.toArray<HTMLElement>('.post-card, .profile').forEach((node) => gsap.from(node, { y:32, autoAlpha:0, duration:.7, ease:'power3.out', scrollTrigger:{ trigger:node, start:'top 86%', once:true } }));
  }
</script>

<style>
  .hero { min-height:100dvh; position:relative; overflow:hidden; isolation:isolate; color:#effdf8; background:radial-gradient(ellipse 70% 70% at 63% 44%,#174465 0%,#0a2136 44%,#07111e 100%); }
  .hero::after { content:''; position:absolute; inset:0; z-index:-1; background:radial-gradient(ellipse 80% 80% at 50% 45%,transparent 35%,rgba(3,10,18,.76)); }
  nav { position:relative; z-index:3; display:flex; justify-content:space-between; align-items:center; max-width:1240px; margin:auto; padding:30px 32px; border-bottom:1px solid var(--white-line); } nav div { display:flex; gap:28px; font-size:14px; color:rgba(239,253,248,.74); } nav a { transition:color .2s; } nav a:hover { color:#b4ffe9; } .brand { font-weight:800; letter-spacing:.18em; font-size:17px; } .brand span { color:#57dfbd; font-size:12px; vertical-align:top; }
  .hero-copy { position:relative; z-index:2; width:min(1240px,100%); margin:clamp(110px,17vh,190px) auto 0; padding:0 32px; } .eyebrow { margin:0 0 17px; font:500 11px 'Roboto Mono',monospace; text-transform:uppercase; letter-spacing:.17em; color:#92dcc9; } h1 { margin:0; max-width:740px; font-size:clamp(59px,9vw,132px); line-height:.88; letter-spacing:-.07em; font-weight:800; } h1 em { color:#caeee6; font-style:normal; font-weight:300; } .hero-copy > p:not(.eyebrow) { margin:30px 0; line-height:1.9; font-size:16px; color:rgba(239,253,248,.78); } .scroll-cue { display:inline-flex; align-items:center; gap:11px; padding:13px 18px; border:1px solid var(--white-line); border-radius:999px; backdrop-filter:blur(8px); font-size:13px; } .scroll-cue b { font-size:20px; color:#69edca; }
  .hero-art { position:absolute; z-index:1; right:6%; bottom:8%; width:min(43vw,610px); height:55vh; opacity:.75; filter:drop-shadow(0 0 55px rgba(126,222,210,.16)); } .moon { position:absolute; width:130px; aspect-ratio:1; border-radius:50%; top:4%; right:11%; background:#d8f5e9; box-shadow:0 0 60px 15px rgba(191,255,235,.26); } .window { position:absolute; width:72%; height:57%; bottom:13%; left:9%; border:13px solid rgba(179,235,228,.5); background:linear-gradient(140deg,rgba(95,235,217,.21),rgba(8,21,43,.35)),repeating-linear-gradient(90deg,transparent 0 31%,rgba(200,250,241,.38) 32% 33%); box-shadow:inset 0 0 70px rgba(0,0,0,.28); } .desk { position:absolute; width:91%; height:15%; left:0; bottom:0; border-radius:3px 3px 20px 20px; background:linear-gradient(#183c4b,#0b1a29); transform:skewX(-7deg); } .lamp { position:absolute; width:12px; height:46%; right:29%; bottom:13%; background:#9eead6; transform:rotate(16deg); box-shadow:0 0 15px #95f4d8; } .lamp::before { content:''; position:absolute; left:-34px; top:-18px; width:80px; height:32px; border-radius:50% 50% 8px 8px; background:#d6fff1; box-shadow:0 0 35px #a9ffe2; }
  .page-shell { display:grid; grid-template-columns:270px minmax(0,1fr); gap:34px; max-width:1240px; margin:0 auto; padding:70px 32px 100px; } .profile { align-self:start; position:sticky; top:24px; padding:30px; border:1px solid var(--line); border-radius:24px; background:rgba(248,251,250,.78); box-shadow:var(--shadow); } .avatar { display:grid; place-items:center; width:74px; height:74px; margin-bottom:22px; border-radius:22px; color:#d8fff2; background:linear-gradient(135deg,#194e59,#0d2235); font-size:33px; font-weight:800; box-shadow:inset 0 0 0 1px rgba(239,253,248,.18); } .mini,.role,.bio { color:var(--muted); } .mini { margin:0; font-size:13px; } .profile h2 { margin:5px 0; font-size:27px; letter-spacing:-.04em; } .role { margin:0; font:12px 'Roboto Mono',monospace; } .bio { line-height:1.75; font-size:14px; margin:25px 0; } .social { display:flex; gap:9px; }.social a { padding:8px 10px; border-radius:9px; color:#147b67; background:#e1f8f1; font-size:12px; font-weight:700; }.side-section { margin-top:30px; padding-top:24px; border-top:1px solid var(--line); }.side-section h3 { margin:0 0 14px; font-size:14px; }.side-section a { display:flex; justify-content:space-between; padding:10px 0; font-size:13px; color:#53636a; border-bottom:1px solid var(--line); }.side-section b { color:#1b9e85; }
  .section-head { display:flex; justify-content:space-between; align-items:end; padding:5px 2px 22px; border-bottom:1px solid var(--line); }.eyebrow.dark { color:#15977f; margin-bottom:9px; }.section-head h2 { margin:0; font-size:33px; letter-spacing:-.05em; }.section-head span { padding-bottom:4px; color:var(--muted); font:12px 'Roboto Mono',monospace; }.post-list { display:grid; gap:18px; margin-top:22px; }.post-card { overflow:hidden; border:1px solid var(--line); border-radius:22px; background:var(--card); box-shadow:0 12px 34px rgba(10,31,36,.06); transition:transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s; }.post-card:hover { transform:translateY(-5px); box-shadow:var(--shadow); }.post-card a { display:grid; grid-template-columns:65px 1fr 150px; min-height:184px; }.post-no { padding:29px 0 0 26px; color:#25ae91; font:12px 'Roboto Mono',monospace; }.post-copy { padding:27px 18px 25px 0; }.meta { margin:0 0 9px; color:#5a8880; font-size:12px; }.post-copy h3 { margin:0 0 11px; max-width:650px; font-size:21px; letter-spacing:-.035em; }.post-copy > p:not(.meta) { margin:0; max-width:650px; color:var(--muted); line-height:1.7; font-size:14px; }.tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:16px; }.tags span { padding:4px 8px; color:#258c78; border-radius:6px; background:#e4f8f2; font-size:11px; }.orb { align-self:stretch; margin:14px 14px 14px 0; border-radius:15px; background:radial-gradient(circle at 68% 31%,#dbfff2 0 4%,transparent 5%),radial-gradient(circle at 45% 46%,#227786 0, #173d60 32%, #0a172b 74%); position:relative; overflow:hidden; }.orb::after { content:''; position:absolute; width:180%; height:1px; left:-40%; top:54%; background:#7cf0d2; transform:rotate(-24deg); box-shadow:0 0 15px #7cf0d2; } .post-card:nth-child(2) .orb { background:radial-gradient(circle at 34% 28%,#edddff,transparent 6%),linear-gradient(135deg,#8b4d85,#2b305d 54%,#132536); }.post-card:nth-child(3) .orb { background:radial-gradient(circle at 75% 30%,#f7df9e,transparent 5%),linear-gradient(135deg,#2b6371,#153047 48%,#102032); }
  footer { display:flex; justify-content:space-between; max-width:1240px; margin:auto; padding:26px 32px; color:#769097; border-top:1px solid var(--line); font:12px 'Roboto Mono',monospace; } footer a { color:#187e6b; }
  @media (max-width:780px) { nav { padding:22px 20px; } nav div { gap:15px; font-size:12px; } .hero-copy { margin-top:135px; padding:0 22px; }.hero-art { width:85vw; right:-14%; opacity:.45; bottom:7%; }.page-shell { display:block; padding:40px 18px 70px; }.profile { position:relative; top:auto; margin-bottom:26px; }.post-card a { grid-template-columns:45px 1fr; }.post-no { padding:23px 0 0 18px; }.post-copy { padding:22px 17px 22px 0; }.post-copy h3 { font-size:18px; }.orb { display:none; } footer { padding:22px 18px; } }
</style>
